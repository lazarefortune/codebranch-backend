# ============================================
# DATABASE
# ============================================
DATABASE_URL=""

# Docker Compose variables
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=codebranch
MYSQL_PORT=3306

# ============================================
# JWT
# ============================================
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# APP
# ============================================
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ============================================
# EMAIL
# ============================================
MAIL_FROM=noreply@codebranch.dev
EMAIL_SMTP_HOS=xxxxxxxxxxxx
EMAIL_USER=xxxxxxxxx
EMAIL_PASSWORD=
