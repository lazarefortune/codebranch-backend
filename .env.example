# ============================================
# DATABASE
# ============================================
DATABASE_URL=""

# Docker Compose variables
MYSQL_ROOT_PASSWORD=change-me-local-only
MYSQL_DATABASE=codebranch
MYSQL_PORT=3306

# ============================================
# JWT
# ============================================
JWT_ACCESS_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-in-production-refresh
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# APP
# ============================================
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ============================================
# EMAIL
# ============================================
MAIL_FROM=noreply@codebranch.dev
EMAIL_SMTP_HOST=xxxxxxxxxxxx
EMAIL_SMTP_PORT=587
EMAIL_USER=xxxxxxxxx
EMAIL_PASSWORD=change-me-local-only
